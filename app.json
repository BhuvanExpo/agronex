{
  "expo": {
    "name": "AgroNex - Crop & Pest Doctor",
    "slug": "agronex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#064E3B",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#022C22",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.agronex.cropdoctor",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#064E3B",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "AgroNex needs access to your gallery to upload crop photos for disease diagnosis.",
          "cameraPermission": "AgroNex needs camera access to take leaf photos to detect crop diseases and pests."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
