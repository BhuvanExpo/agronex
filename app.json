{
  "expo": {
    "name": "AgroNex - Crop & Pest Doctor",
    "slug": "agronex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#064E3B",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.agronex.cropdoctor",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#064E3B",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "AgroNex needs access to your gallery to upload crop photos for disease diagnosis.",
          "cameraPermission": "AgroNex needs camera access to take leaf photos to detect crop diseases and pests."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "28e1f9cd-c396-49a3-bba3-bff1925c81b0"
      }
    },
    "owner": "bhuvangm"
  }
}
